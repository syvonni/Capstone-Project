// Helper function to map conditional fee customIds to IDs
async function mapConditionalFeeCustomIdsToIds(customIds) {
  if (!customIds || customIds.length === 0) return []

  const fees = await ConditionalFee.find({ customId: { $in: customIds }, isActive: true })
  const customIdToIdMap = fees.reduce((acc, fee) => {
    acc[fee.customId] = fee._id
    return acc
  }, {})

  return customIds.map(customId => customIdToIdMap[customId]).filter(id => id)
}

// Helper function to map variable fee rule customIds to IDs
async function mapVariableFeeRuleCustomIdsToIds(customIds) {
  if (!customIds || customIds.length === 0) return []

  const rules = await VariableFeeRule.find({ customId: { $in: customIds }, isActive: true })
  const customIdToIdMap = rules.reduce((acc, rule) => {
    acc[rule.customId] = rule._id
    return acc
  }, {})

  return customIds.map(customId => customIdToIdMap[customId]).filter(id => id)
}

// Helper function to map license names to IDs
async function mapLicenseNamesToIds(licenseNames) {
  if (!licenseNames || licenseNames.length === 0) return []

  // For now, return the license names as-is since we don't have a License model
  // This will need to be updated when the License model is implemented
  return licenseNames
}

